      "NodeStatus": {
        "description": "One activity in the graph.\n\n``blocked`` is not a failure: it is a merge conflict or a permission gate\nwaiting on a human, and it is reachable again. ``failed`` is the run's\nverdict. They are separate states because the operator's next action\ndiffers, which is also why `docs/design-system.md` \u00a75 distinguishes them by\nicon rather than by hue.",
        "enum": [
          "pending",
          "ready",
          "running",
          "awaiting_review",
          "blocked",
          "done",
          "failed",
          "skipped"
        ],
        "title": "NodeStatus",
        "type": "string"
      },
