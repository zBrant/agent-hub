      "RunState": {
        "description": "One execution of a node.\n\n``RUNNING`` is the only non-terminal member and the only one with no\ncounterpart in ``RunStatus``: a harness never *reports* \"still running\", it\nis the state of a row between :class:`~app.harnesses.events.RunStarted` and\n:class:`~app.harnesses.events.RunFinished`. A row still ``RUNNING`` after an\norchestrator restart is an orphan, and the scheduler resolves it to\n``INTERRUPTED`` rather than to a sixth state.",
        "enum": [
          "running",
          "success",
          "failed",
          "interrupted",
          "budget_exceeded"
        ],
        "title": "RunState",
        "type": "string"
      },
