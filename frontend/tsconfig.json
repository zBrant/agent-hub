{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  /* Duplicated from tsconfig.app.json only so the shadcn CLI can resolve the
     `@/` alias; it reads the root tsconfig, not the solution references. */
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
